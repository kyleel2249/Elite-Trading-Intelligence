{
  "name": "eti",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "containers": [
    {
      "class_name": "EtiContainer",
      "image": "./Dockerfile",
      "max_instances": 1,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "EtiContainer", "name": "ETI_CONTAINER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EtiContainer"] }],
  "observability": { "enabled": true }
}
