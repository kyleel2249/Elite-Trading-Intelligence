
{
  "name": "elite-trading-intelligence-eti",
  "main": "worker/main.ts",
  "build": {
    "command": "node scripts/build-knowledge.mjs",
    "watch_dir": "app/knowledge"
  },
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "ETI_EDGE": "native",
    "ETI_KILL_SWITCH": "false",
    "ETI_LIVE_TRADING_ENABLED": "false",
    "DATABASE_URL": "postgresql+psycopg2://eti:eti@localhost:5432/eti",
    "MARKET_PROVIDER_ORDER": "binance,bybit,okx"
  },
  "kv_namespaces": [
    {
      "binding": "ETI_EXECUTION_LOG",
      "id": "da68ec381049420faa497428ea7f8180"
    }
  ],
  "d1_databases": [
    {
      "binding": "ETI-PORTFOLIO-DB",
      "database_id": "e132826d-a725-41da-982c-5431ab1eb4f3"
    }
  ]
}
