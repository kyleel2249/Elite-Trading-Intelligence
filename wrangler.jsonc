{
  // Plain Worker (no Cloudflare Containers). Proxies to BACKEND_URL.
  "name": "elite-trading-intelligence-eti",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  // Retire the previous Container Durable Object so deploy does not require Containers API.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["EtiContainer"] },
    { "tag": "v2", "deleted_classes": ["EtiContainer"] }
  ],
  "vars": {
    "ETI_EDGE": "proxy"
  }
}
