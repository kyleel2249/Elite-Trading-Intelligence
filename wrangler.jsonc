{
  "name": "elite-trading-intelligence-eti",
  "main": "worker/main.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "build": {
    "command": "node scripts/build-knowledge.mjs"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "ETI_KILL_SWITCH": "false",
    "ETI_LIVE_TRADING_ENABLED": "false",
    "ETI_EDGE": "native",
    "MARKET_PROVIDER_ORDER": "binance,bybit,okx"
  },
  "kv_namespaces": [
    {
      "binding": "ETI_EXECUTION_LOG",
      "id": "da68ec381049420faa497428ea7f8180"
    }
  ]
}
