{
  "name": "elite-trading-intelligence-eti",
  "main": "worker/main.ts",
  "build": {
    "command": "node scripts/build-knowledge.mjs",
    "watch_dir": "app/knowledge"
  },
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "placement": {
    "region": "aws:eu-central-1"
  },
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "* * * * *",
      "*/5 * * * *"
    ]
  },
  "vars": {
    "APP_ENV": "production",
    "CHAIN_ENABLED": "true",
    "CHAIN_MAINNET_SEND_ENABLED": "on",
    "DATABASE_URL": "postgresql+psycopg2://user:pass@host:5432/eti",
    "ETI_EDGE": "native",
    "ETI_EVENT_FEED_URL": "https://finnhub.io/api/v1/calendar/economic",
    "ETI_FX_CANDLES_URL": "https://api.twelvedata.com/time_series",
    "ETI_ANALYSIS_PLAN": "free",
    "ETI_KILL_SWITCH": "false",
    "ETI_PAPER_SYMBOLS": "ALL",
    "ETI_PAPER_STRATEGY": "intraday",
    "ETI_PAPER_AUTOEXECUTE": "true",
    "ETI_AUTO_ROLLBACK": "true",
    "ETI_UNIVERSE_ENABLED": "true",
    "ETI_UNIVERSE_STRATEGY": "intraday",
    "ETI_UNIVERSE_MAX_SYMBOLS": "300",
    "ETI_UNIVERSE_MIN_QUOTE_VOLUME": "1000000",
    "ETI_UNIVERSE_MAX_SPREAD_BPS": "50",
    "ETI_UNIVERSE_BATCH": "3",
    "ETI_RISK_PER_TRADE": "0.005",
    "ETI_RISK_MAX_NOTIONAL": "0.5",
    "ETI_RISK_MAX_POSITIONS": "3",
    "ETI_RISK_MAX_DAILY_LOSS": "0.02",
    "ETI_RISK_MAX_CONSECUTIVE_LOSSES": "3",
    "ETI_RISK_MIN_REWARD_RISK": "1.5",
    "ETI_RISK_MAX_LEVERAGE": "1",
    "ETI_RISK_MIN_CASH_RESERVE": "0.5",
    "ETI_RISK_MAX_DRAWDOWN": "0.1",
    "PAPER_AUTOPILOT": "true",
    "MARKET_PROVIDER_ORDER": "bybit",
    "SEC_USER_AGENT": "ETI (Elite Trading Intelligence; contact: davinatirzah@gmail.com)"
  },
  "d1_databases": [
    {
      "binding": "ETI_PORTFOLIO_DB",
      "database_name": "eti-portfolio-db",
      "database_id": "e132826d-a725-41da-982c-5431ab1eb4f3",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ETI_EXECUTION_LOG",
      "id": "da68ec381049420faa497428ea7f8180"
    }
  ]
}
