# =============================================================================
# ETI — Elite Trading Intelligence
# Copy to .env and fill real values. NEVER commit .env
# =============================================================================

# development = open mutating routes if API_KEY unset; use production on any public host
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Protects mutating routes (header X-API-Key). REQUIRED when APP_ENV is
# production/prod/staging: with no key set, those routes refuse requests (HTTP 503).
# Live orders are also refused (HTTP 403) whenever no API_KEY is configured.
API_KEY=

# SQLite (default) or Postgres:
# DATABASE_URL=sqlite:///./eti.db
# DATABASE_URL=postgresql+psycopg2://eti:eti@localhost:5432/eti
DATABASE_URL=sqlite:///./eti.db

LIVE_TRADING_ENABLED=false
# Emergency halt for all order submission (paper and live)
KILL_SWITCH=false
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_PORTFOLIO_DRAWDOWN_PCT=10.0
MAX_OPEN_POSITIONS=8
# Hard cap: single position notional vs equity (product rule)
MAX_POSITION_NOTIONAL_PCT=6.0
REQUIRE_LIVE_CONFIRMATION=true

# Server-side equity baselines for the risk engine. The API never trusts equity
# sent in a request. Paper equity = PAPER_STARTING_EQUITY + realized + unrealized PnL.
PAPER_STARTING_EQUITY=10000
# Optional fallback if broker equity sync fails; live prefers broker account equity.
# LIVE_ACCOUNT_EQUITY=10000
USE_BROKER_EQUITY_FOR_LIVE=true

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Only used when ALPACA_PAPER=false and LIVE_TRADING_ENABLED=true
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET_ENABLED=true
BINANCE_LIVE_TRADING_ENABLED=false

# OANDA v20 — forex, spot metals, index/commodity CFDs. Paper trading uses an OANDA *practice* account.
# Create a practice account + API token at OANDA; never commit real values. Live stays off unless enabled below.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_LIVE_TRADING_ENABLED=false

# Adaptive edge background cycle (seconds)
ADAPTIVE_EDGE_INTERVAL_SECONDS=900

# Optional — Sofia Rahman (macro) / Priya Nair (sentiment)
FRED_API_KEY=
NEWSAPI_KEY=

# Quiver Quant — research / disclosure only (never execution)
# https://api.quiverquant.com/docs/authentication
QUIVER_API_KEY=

# Liquid — only if YOU verified a base URL; ETI does not invent exchange endpoints
# Withdrawals are never requested
LIQUID_API_KEY=
LIQUID_API_BASE_URL=

# -----------------------------------------------------------------------------
# Analytics intelligence providers (docs/PROVIDERS.md). Read-only data; never used for execution.
# FMP: economic + earnings calendar. Check which endpoints your plan allows.
FMP_API_KEY=
# Tokenomist: token unlock schedules (API v5, personal/non-commercial licence, monthly credit quota)
TOKENOMIST_API_KEY=
# Stop spending Tokenomist credits when this fraction of the monthly quota remains
TOKENOMIST_CREDIT_RESERVE=0.10
# Bearer token the Worker sends (ETI_EVENT_FEED_TOKEN) to GET /api/analytics/intel/calendar/feed.
# Use a long random value. REQUIRED when APP_ENV is production/prod/staging (the feed refuses requests without it).
EVENT_FEED_TOKEN=
# Reserved for a future whale-transfer adapter (not built; key is not used yet)
WHALE_ALERT_API_KEY=

MTM_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=120
INVESTOR_MONITOR_INTERVAL_SECONDS=1800

DATA_MAX_AGE_SECONDS=300
REQUIRE_FRESH_DATA_FOR_LIVE_ORDERS=true
DEFAULT_TIMEZONE=Africa/Accra

# -----------------------------------------------------------------------------
# Internal paper trading (docs/PAPER_TRADING.md). Needs NO exchange credentials.
# -----------------------------------------------------------------------------
PAPER_TAKER_FEE_BPS=10
PAPER_MAKER_FEE_BPS=10
PAPER_EXTRA_SLIPPAGE_BPS=1
PAPER_MAX_POSITION_NOTIONAL_PCT=25
PAPER_TICK_INTERVAL_SECONDS=5
# Simulated autonomous trading from Trading Council signals (paper money only)
PAPER_AUTOPILOT_ENABLED=false
PAPER_AUTOPILOT_SYMBOLS=BTCUSDT,ETHUSDT
PAPER_AUTOPILOT_INTERVAL_SECONDS=120
PAPER_AUTOPILOT_MIN_CONFIDENCE=0.6

# -----------------------------------------------------------------------------
# Autonomous execution engine (docs/EXECUTION_ENGINE.md). Off by default.
# Broker credentials are registered through POST /api/execution/accounts and stored
# encrypted; they are NOT read from this file. Use trade-only keys: never enable withdrawals.
# -----------------------------------------------------------------------------
EXECUTION_ENABLED=false
# Fernet key. Generate: python -c "from app.execution.vault import CredentialVault; print(CredentialVault.generate_key())"
# Keep it in your host's secret store, separate from DATABASE_URL.
EXECUTION_VAULT_KEY=
EXECUTION_SUPERVISOR_INTERVAL_SECONDS=15

# Analysis engine (Cloudflare Worker, /api/analysis/*). All OPTIONAL and PRIVATE.
# Set them as Worker secrets:  npx wrangler secret put FRED_API_KEY   (never in vars, never in browser code)
# Without them the affected engine reports "unavailable" and says what to configure: nothing is fabricated.
# -----------------------------------------------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html  (currency macro: rates, CPI, unemployment, GDP, yields, dollar index)
FRED_API_KEY=
# SEC EDGAR requires a descriptive User-Agent with contact details, e.g. "Your Org admin@yourdomain.com"  (stock fundamentals)
SEC_USER_AGENT=
# Optional CoinGecko demo key (higher rate limits for crypto fundamentals)
COINGECKO_API_KEY=
# Optional JSON overrides. NEWS_FEEDS_JSON: [{"name":"...","url":"https://...","type":"central_bank|regulator|exchange|company|wire|research|media"}]
# FRED_SERIES_JSON: {"EUR":{"policyRate":"<id>","inflation":{"id":"<id>","transform":"yoy_index"},"unemployment":"<id>","gdp":"<id>","yield10y":"<id>"}}
NEWS_FEEDS_JSON=
FRED_SERIES_JSON=
