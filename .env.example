# =============================================================================
# ETI — Elite Trading Intelligence
# Copy to .env and fill real values. NEVER commit .env
# =============================================================================

# Use development only for intentionally unauthenticated local work.
APP_ENV=production
# development = open mutating routes if API_KEY unset; use production on any public host
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string

# Protects mutating routes (header X-API-Key). REQUIRED when APP_ENV is
# production/prod/staging: with no key set, those routes refuse requests (HTTP 503).
# Live orders are also refused (HTTP 403) whenever no API_KEY is configured.
API_KEY=

# SQLite (default) or Postgres:
# DATABASE_URL=sqlite:///./eti.db
# DATABASE_URL=postgresql+psycopg2://eti:eti@localhost:5432/eti
DATABASE_URL=sqlite:///./eti.db

LIVE_TRADING_ENABLED=false

# -----------------------------------------------------------------------------
# ETI CAPITAL PROTECTION SYSTEM — independent veto on every order (cannot be disabled).
# Conservative defaults shown. Every value is clamped to a hard ceiling in
# app/risk/protection_policy.py, so a typo cannot silently remove protection.
# -----------------------------------------------------------------------------
CPS_MAX_RISK_PER_TRADE_PCT=0.5
CPS_MAX_DAILY_LOSS_PCT=2.0
CPS_MAX_WEEKLY_LOSS_PCT=5.0
CPS_MAX_DRAWDOWN_PCT=10.0
CPS_MAX_OPEN_POSITIONS=5
CPS_MAX_CORRELATED_EXPOSURE_PCT=20.0
CPS_MAX_LEVERAGE=1.0
CPS_MAX_POSITION_NOTIONAL_PCT=6.0
CPS_MAX_CONSECUTIVE_LOSSES=3
CPS_CONSECUTIVE_LOSS_COOLDOWN_MINUTES=240
# Emergency liquidation (halts trading and flattens positions)
CPS_EMERGENCY_DRAWDOWN_PCT=12.0
CPS_EMERGENCY_DAILY_LOSS_PCT=4.0
# Volatility-adjusted sizing: risk shrinks as ATR% rises above the target; entries stop at the extreme level
CPS_TARGET_VOLATILITY_PCT=2.0
CPS_EXTREME_VOLATILITY_PCT=12.0
CPS_MIN_STOP_DISTANCE_PCT=0.1
CPS_MAX_STOP_DISTANCE_PCT=10.0
# Sessions: US equities only inside regular hours (+buffer). Extra blocked windows in UTC, e.g. "23:55-00:05,21:55-22:05"
CPS_SESSION_RESTRICTIONS_ENABLED=true
CPS_EQUITY_SESSION_BUFFER_MINUTES=15
CPS_BLOCKED_WINDOWS_UTC=
# News: orders pause around high-impact events loaded via POST /api/capital-protection/news-calendar
CPS_NEWS_BLACKOUT_BEFORE_MINUTES=30
CPS_NEWS_BLACKOUT_AFTER_MINUTES=30
CPS_NEWS_CALENDAR_REQUIRED_FOR_LIVE=true
CPS_REQUIRE_STRATEGY_ATTRIBUTION_LIVE=true
CPS_AUTO_LIQUIDATE_ON_STOP_BREACH=true
CPS_AUTO_LIQUIDATE_ON_EMERGENCY=true
# HUMAN-ONLY secret (>=16 chars, must differ from API_KEY) that releases halts / quarantines and registers
# strategies. Never give it to an AI agent, automation, or the Cloudflare Worker.
CPS_ADMIN_KEY=
# Emergency halt for all order submission (paper and live)
KILL_SWITCH=false
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_PORTFOLIO_DRAWDOWN_PCT=10.0
MAX_OPEN_POSITIONS=8
# Hard cap: single position notional vs equity (product rule)
MAX_POSITION_NOTIONAL_PCT=6.0
REQUIRE_LIVE_CONFIRMATION=true

# Server-side equity baselines for the risk engine. The API never trusts equity
# sent in a request. Paper equity = PAPER_STARTING_EQUITY + realized + unrealized PnL.
PAPER_STARTING_EQUITY=10000
# Optional fallback if broker equity sync fails; live prefers broker account equity.
# LIVE_ACCOUNT_EQUITY=10000
USE_BROKER_EQUITY_FOR_LIVE=true

ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Only used when ALPACA_PAPER=false and LIVE_TRADING_ENABLED=true
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Bybit V5 — testnet keys are the only keys used for automatic testnet provisioning.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_TESTNET_ENABLED=true
BYBIT_LIVE_TRADING_ENABLED=false
# Optional direct account settings for manually registered execution accounts:
BYBIT_API_KEY=
BYBIT_API_SECRET=

# OANDA v20 — forex, spot metals, index/commodity CFDs. Paper trading uses an OANDA *practice* account.
# Create a practice account + API token at OANDA; never commit real values. Live stays off unless enabled below.
OANDA_API_TOKEN=
OANDA_ACCOUNT_ID=
OANDA_LIVE_TRADING_ENABLED=false

# Adaptive edge background cycle (seconds)
ADAPTIVE_EDGE_INTERVAL_SECONDS=900

# Optional — Sofia Rahman (macro) / Priya Nair (sentiment)
FRED_API_KEY=
NEWSAPI_KEY=

# Quiver Quant — research / disclosure only (never execution)
# https://api.quiverquant.com/docs/authentication
QUIVER_API_KEY=

# Liquid — only if YOU verified a base URL; ETI does not invent exchange endpoints
# Withdrawals are never requested
LIQUID_API_KEY=
LIQUID_API_BASE_URL=

# -----------------------------------------------------------------------------
# Analytics intelligence providers (docs/PROVIDERS.md). Read-only data; never used for execution.
# Set these as BACKEND secrets only (never in frontend code). Verify at /static/integration_health.html.
# FMP: economic + earnings calendar, profile, quote, income statement, key metrics. Plan access varies per endpoint.
# FMP: economic + earnings calendar. Check which endpoints your plan allows.
FMP_API_KEY=
# Tokenomist: token unlock schedules (API v5, personal/non-commercial licence, monthly credit quota)
TOKENOMIST_API_KEY=
# Stop spending Tokenomist credits when this fraction of the monthly quota remains
TOKENOMIST_CREDIT_RESERVE=0.10
# Whale Alert Enterprise REST API key (leviathan.whale-alert.io). The cheaper Alerts plan is WebSocket-only and does not work here.
WHALE_ALERT_API_KEY=
# Shared secret between the Cloudflare Worker and this backend for GET /api/analytics/intel/calendar/feed.
# Set the SAME value here (EVENT_FEED_TOKEN or ETI_EVENT_FEED_TOKEN) and on the Worker as secret ETI_EVENT_FEED_TOKEN,
# and set the Worker's ETI_EVENT_FEED_URL to https://<backend>/api/analytics/intel/calendar/feed. Use a long random value.
# REQUIRED when APP_ENV is production/prod/staging (the feed refuses requests without it).
EVENT_FEED_TOKEN=
# Bearer token the Worker sends (ETI_EVENT_FEED_TOKEN) to GET /api/analytics/intel/calendar/feed.
# Use a long random value. REQUIRED when APP_ENV is production/prod/staging (the feed refuses requests without it).
EVENT_FEED_TOKEN=
# Reserved for a future whale-transfer adapter (not built; key is not used yet)
WHALE_ALERT_API_KEY=

MTM_INTERVAL_SECONDS=60
RECONCILE_INTERVAL_SECONDS=120
INVESTOR_MONITOR_INTERVAL_SECONDS=1800

DATA_MAX_AGE_SECONDS=300
REQUIRE_FRESH_DATA_FOR_LIVE_ORDERS=true
DEFAULT_TIMEZONE=Africa/Accra

# -----------------------------------------------------------------------------
# Internal paper trading (docs/PAPER_TRADING.md). Needs NO exchange credentials.
# -----------------------------------------------------------------------------
PAPER_TAKER_FEE_BPS=10
PAPER_MAKER_FEE_BPS=10
PAPER_EXTRA_SLIPPAGE_BPS=1
PAPER_MAX_POSITION_NOTIONAL_PCT=25
PAPER_TICK_INTERVAL_SECONDS=5
# Simulated autonomous trading from Trading Council signals (paper money only)
PAPER_AUTOPILOT_ENABLED=false
PAPER_AUTOPILOT_SYMBOLS=BTCUSDT,ETHUSDT
PAPER_AUTOPILOT_INTERVAL_SECONDS=120
PAPER_AUTOPILOT_MIN_CONFIDENCE=0.6

# -----------------------------------------------------------------------------
# Autonomous execution engine (docs/EXECUTION_ENGINE.md). Off by default.
# Broker credentials are registered through POST /api/execution/accounts and stored
# encrypted; they are NOT read from this file. Use trade-only keys: never enable withdrawals.
# -----------------------------------------------------------------------------
EXECUTION_ENABLED=false
# Fernet key. Generate: python -c "from app.execution.vault import CredentialVault; print(CredentialVault.generate_key())"
# Keep it in your host's secret store, separate from DATABASE_URL.
# The on-chain ETI wallet (below) uses this SAME vault key to encrypt its private key.
EXECUTION_VAULT_KEY=
EXECUTION_SUPERVISOR_INTERVAL_SECONDS=15

# -----------------------------------------------------------------------------
# ETI on-chain wallet (docs/CHAIN.md). The private key is generated on the server and stored encrypted with
# EXECUTION_VAULT_KEY; it is never returned or exported. Testnets only unless you enable mainnet below.
# RPC URLs often contain API keys: keep them in the host's secret store.
# -----------------------------------------------------------------------------
CHAIN_ENABLED=true
# Optional private RPC per network (hyphens become underscores). Sepolia has a public default; mainnets have none.
# CHAIN_RPC_SEPOLIA=
# CHAIN_RPC_BASE_SEPOLIA=
# CHAIN_RPC_ETHEREUM=
# Spending policy (native-coin units). Failed broadcasts do not count toward the 24h cap.
CHAIN_MAX_SLIPPAGE_BPS=100
CHAIN_REQUIRE_ALLOWLIST=true
# Leave false until you have run on a testnet and accept that mainnet transactions move real value.
CHAIN_MAINNET_SEND_ENABLED=false
# DEX trading: a Uniswap-V2-style router and the wrapped-native token. VERIFY these addresses yourself; ETI hard-codes none.
# CHAIN_DEX_ROUTER_SEPOLIA=
# CHAIN_WRAPPED_NATIVE_SEPOLIA=

# Analysis engine (Cloudflare Worker, /api/analysis/*). All OPTIONAL and PRIVATE.
# Set them as Worker secrets:  npx wrangler secret put FRED_API_KEY   (never in vars, never in browser code)
# Without them the affected engine reports "unavailable" and says what to configure: nothing is fabricated.
# -----------------------------------------------------------------------------
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html  (currency macro: rates, CPI, unemployment, GDP, yields, dollar index)
# (FRED_API_KEY is listed above; the Worker reads its own copy as a Worker secret.)
# SEC EDGAR requires a descriptive User-Agent with contact details, e.g. "Your Org admin@yourdomain.com"  (stock fundamentals)
SEC_USER_AGENT=
# Optional CoinGecko demo key (higher rate limits for crypto fundamentals)
COINGECKO_API_KEY=
# Optional JSON overrides. NEWS_FEEDS_JSON: [{"name":"...","url":"https://...","type":"central_bank|regulator|exchange|company|wire|research|media"}]
# FRED_SERIES_JSON: {"EUR":{"policyRate":"<id>","inflation":{"id":"<id>","transform":"yoy_index"},"unemployment":"<id>","gdp":"<id>","yield10y":"<id>"}}
NEWS_FEEDS_JSON=
FRED_SERIES_JSON=

# --- Precision signal engine ---
# Admin token (secret, 16+ chars) for PUT/DELETE /api/precision/admin/* and POST /api/precision/admin/cycle. Unset = admin routes return 403.
# ETI_PRECISION_ADMIN_TOKEN=
# Optional JSON override of weights/bands/gates (all-or-nothing). Public-safe; contains no secrets.
# ETI_PRECISION_CONFIG=
# Scheduled outcome ledger (off unless symbols are set and a KV namespace is bound): crypto symbols, strategies, pairs per cron tick.
# ETI_PRECISION_SYMBOLS=BTCUSDT,ETHUSDT
# ETI_PRECISION_STRATEGIES=intraday
# ETI_PRECISION_BATCH=1

# --- Analysis engine additions (see docs/ANALYSIS_ENGINE.md) ---
# -----------------------------------------------------------------------------
# Analysis engine, additional settings. Secrets via:  npx wrangler secret put <NAME>
# -----------------------------------------------------------------------------
# Cloudflare plan: "free" (default; lite detail, capped inputs, calibration refused) or "paid" (full detail, calibration). Set in wrangler.jsonc vars.
ETI_ANALYSIS_PLAN=free
# Optional GitHub token (no permissions needed) to lift the 60 requests/hour limit used for development-activity data
GITHUB_TOKEN=
# Operator-curated crypto facts no free API provides (team identity, regulatory status, audits you verified, unlock schedules):
# {"SYMBOL":{"team":{"publiclyIdentified":true,"founders":["..."]},"regulatory":{"risk":"low|medium|high","notes":"..."},"audits":[{"firm":"...","url":"https://..."}],"source":"who verified this","asOf":"YYYY-MM-DD"}}
CRYPTO_PROFILES_JSON=
# Optional AI second opinion on headline sentiment (also needs an "ai": {"binding": "AI"} entry in wrangler.jsonc). Model id is configurable.
SENTIMENT_AI=off
SENTIMENT_AI_MODEL=@cf/meta/llama-3.1-8b-instruct
# Used only by the offline 13F pipeline (scripts/13f-build.ts), not by the Worker: faster CUSIP -> ticker resolution
OPENFIGI_API_KEY=

# Refresh Bybit / Bitget / Alpaca pair lists every minute from boot (ignored when APP_ENV=test)
SYMBOL_SYNC_ENABLED=true
