# =============================================================================
# ETI — Elite Trading Intelligence
# Copy to .env and fill real values. NEVER commit .env
# =============================================================================

# Application
APP_ENV=development
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./eti.db

# Global trading mode
# LIVE_TRADING_ENABLED=true allows the live path when risk engine approves
LIVE_TRADING_ENABLED=true
DEFAULT_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=3.0
MAX_PORTFOLIO_DRAWDOWN_PCT=10.0
MAX_OPEN_POSITIONS=8
MAX_CORRELATED_EXPOSURE_PCT=25.0

# Alpaca
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true
# Set ALPACA_PAPER=false only when you intentionally want live Alpaca
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live: https://api.alpaca.markets

# Binance
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET_ENABLED=true
BINANCE_LIVE_TRADING_ENABLED=true
# Testnet base: https://testnet.binance.vision
# Production base: https://api.binance.com

# Data quality
DATA_MAX_AGE_SECONDS=300
REQUIRE_FRESH_DATA_FOR_LIVE_ORDERS=true

# Display
DEFAULT_TIMEZONE=Africa/Accra
