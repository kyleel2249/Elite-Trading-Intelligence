{
  "name": "eti-cloudflare",
  "private": true,
  "version": "1.3.0",
  "description": "Cloudflare-native ETI market intelligence dashboard",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "check:worker": "wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test worker/*.test.ts worker/algo/*.test.ts worker/alpha/*.test.ts worker/command/*.test.ts worker/precision/*.test.ts",
    "check": "npm run test && npm run check:worker",
    "build:knowledge": "node scripts/build-knowledge.mjs",
    "pretest": "npm run build:knowledge"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
